# Build directories
build/
out/
bin/
lib/
cmake-build-*/

# Compiled C / C++ binaries and object files
*.exe
*.dll
*.so
*.dylib
*.lib
*.a
*.obj
*.o
*.pdb
*.ilk
*.exp
*.idb
*.pch

# CMake & Ninja generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
compile_commands.json
Makefile
*.ninja
.ninja_deps
.ninja_log

# Visual Studio & IDE caches
.vs/
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
.cache/
.idea/

# Keep VS Code shared tasks/settings if desired, ignore local clutter
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# Third-party libraries (keep locally in /vendor so Copilot skips indexing 250k+ lines)
/vendor/

# Local runtime databases, ImGui window state, and exports
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
imgui.ini
*.log
*.csv

# Windows OS clutter
Thumbs.db
ehthumbs.db
Desktop.ini